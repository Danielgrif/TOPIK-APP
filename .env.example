# =============================================================================
# .env.example — шаблон переменных окружения TOPIK APP
# =============================================================================
# ⚠️  ВАЖНО: любые переменные с префиксом VITE_* ВСТРАИВАЮТСЯ В КЛИЕНТСКИЙ
#     JavaScript-бандл Vite и доступны всем посетителям сайта.
#     Никогда не помещайте в VITE_* секреты (service role, Gemini, API-ключи).
#
# Правила:
#   • значения НЕ приводятся — скопируйте файл в .env и заполните локально;
#   • .env в репозиторий не коммитится;
#   • серверные ключи задаются в Supabase Dashboard → Edge Functions → Secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# ПУБЛИЧНЫЕ КЛЮЧИ (попадут в бандл через Vite — можно увидеть в браузере)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# -----------------------------------------------------------------------------
# СЕРВЕРНЫЕ ОБЩИЕ ПЕРЕМЕННЫЕ (Edge Functions, не попадают в бандл)
# -----------------------------------------------------------------------------
SUPABASE_URL=
# Публичный anon/publishable ключ; можно использовать на сервере, но не секрет.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# СЕКРЕТЫ SUPABASE (обходит RLS — строго server-side!)
# Достаточно одного канонического имени; остальные — поддерживаемые алиасы.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=
SB_SECRET_KEY=
SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# СЕКРЕТЫ ВНЕШНИХ API (только Edge Functions)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Секрет для вызова background-worker по cron (заголовок Authorization: Bearer ...)
CRON_SECRET=
